<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Magic Reward Board 🌟</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Nunito:wght@600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #2b1055;
            --card-bg: rgba(255, 255, 255, 0.95);
            --primary: #ffd700;
            --text-dark: #2d3436;
            --btn-add: #2ecc71;
            --btn-remove: #e74c3c;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #2b1055 0%, #7597de 100%);
            color: var(--text-dark);
            min-height: 100vh;
            padding: 2rem;
            overflow-x: hidden;
        }

        /* Full screen confetti canvas */
        #confetti-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9999;
        }

        .header {
            text-align: center;
            margin-bottom: 3rem;
            color: white;
        }

        .header h1 {
            font-family: 'Fredoka', sans-serif;
            font-size: 3.5rem;
            text-shadow: 3px 3px 0px rgba(0,0,0,0.2);
            margin-bottom: 1rem;
        }

        .input-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            max-width: 500px;
            margin: 0 auto;
        }

        .input-group input {
            flex: 1;
            padding: 15px 25px;
            font-size: 1.2rem;
            font-family: 'Nunito', sans-serif;
            border: none;
            border-radius: 50px;
            outline: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .input-group button {
            background-color: var(--btn-add);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 15px 30px;
            font-size: 1.2rem;
            font-family: 'Fredoka', sans-serif;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            transition: 0.2s;
        }

        .input-group button:hover {
            transform: scale(1.05);
            background-color: #27ae60;
        }

        .board {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .student-card {
            background: var(--card-bg);
            border-radius: 25px;
            padding: 1.5rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            position: relative;
            transition: transform 0.3s ease;
        }

        .student-card:hover {
            transform: translateY(-5px);
        }

        .delete-btn {
            position: absolute;
            top: 15px;
            right: 15px;
            background: #ff7675;
            color: white;
            border: none;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            cursor: pointer;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .student-name {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.8rem;
            margin-bottom: 1rem;
            color: #34495e;
            border-bottom: 2px dashed #bdc3c7;
            padding-bottom: 0.5rem;
            padding-right: 30px;
        }

        .stickers-display {
            font-size: 1.5rem;
            min-height: 40px;
            margin-bottom: 1rem;
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

        .sticker-anim {
            animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .controls {
            display: flex;
            justify-content: space-between;
            background: #f1f2f6;
            padding: 10px;
            border-radius: 15px;
        }

        .control-group {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .action-btn {
            border: none;
            border-radius: 10px;
            width: 35px;
            height: 35px;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.1s;
        }

        .action-btn:active {
            transform: scale(0.9);
        }

        .btn-add-star { background: #ffeaa7; }
        .btn-rem-star { background: #ff7675; color: white;}
        .btn-add-heart { background: #fab1a0; }
        .btn-add-trophy { background: #81ecec; }

        @keyframes popIn {
            0% { transform: scale(0); opacity: 0; }
            80% { transform: scale(1.2); }
            100% { transform: scale(1); opacity: 1; }
        }

        @media (max-width: 600px) {
            .header h1 { font-size: 2.5rem; }
            .input-group { flex-direction: column; }
        }
    </style>
</head>
<body>

    <canvas id="confetti-canvas"></canvas>

    <div class="header">
        <h1>🌟 Magic Reward Board 🌟</h1>
        <div class="input-group">
            <input type="text" id="student-name" placeholder="Enter student's name..." onkeypress="handleEnter(event)">
            <button onclick="addStudent()">Add Student</button>
        </div>
    </div>

    <div class="board" id="board">
        <!-- Student cards will be generated here -->
    </div>

    <script>
        // State Management with LocalStorage
        let students = JSON.parse(localStorage.getItem('rewardBoardData')) || [];

        const board = document.getElementById('board');
        const nameInput = document.getElementById('student-name');

        function saveToStorage() {
            localStorage.setItem('rewardBoardData', JSON.stringify(students));
        }

        function handleEnter(e) {
            if (e.key === 'Enter') {
                addStudent();
            }
        }

        function addStudent() {
            const name = nameInput.value.trim();
            if (name === '') return;

            const newStudent = {
                id: Date.now(),
                name: name,
                stars: 0,
                hearts: 0,
                trophies: 0
            };

            students.push(newStudent);
            saveToStorage();
            nameInput.value = '';
            renderBoard();
        }

        function removeStudent(id) {
            if(confirm("Are you sure you want to remove this student?")) {
                students = students.filter(s => s.id !== id);
                saveToStorage();
                renderBoard();
            }
        }

        function updateSticker(id, type, amount) {
            const studentIndex = students.findIndex(s => s.id === id);
            if (studentIndex > -1) {
                // Prevent negative stickers
                if (students[studentIndex][type] + amount < 0) return;
                
                students[studentIndex][type] += amount;
                saveToStorage();
                renderBoard();

                // Confetti trigger for milestone stars (5 or 10)
                if (type === 'stars' && amount > 0) {
                    const totalStars = students[studentIndex].stars;
                    if (totalStars === 5 || totalStars === 10) {
                        fireConfetti();
                    }
                }
            }
        }

        function renderBoard() {
            board.innerHTML = '';
            
            students.forEach(student => {
                const card = document.createElement('div');
                card.className = 'student-card';

                // Generate stickers string
                let stickersHTML = '';
                for(let i=0; i<student.stars; i++) stickersHTML += `<span class="sticker-anim">⭐</span>`;
                for(let i=0; i<student.hearts; i++) stickersHTML += `<span class="sticker-anim">❤️</span>`;
                for(let i=0; i<student.trophies; i++) stickersHTML += `<span class="sticker-anim">🏆</span>`;

                card.innerHTML = `
                    <button class="delete-btn" onclick="removeStudent(${student.id})">×</button>
                    <div class="student-name">${student.name}</div>
                    <div class="stickers-display">${stickersHTML || '<span style="color:#bdc3c7; font-size:1rem;">No stickers yet</span>'}</div>
                    
                    <div class="controls">
                        <div class="control-group">
                            <button class="action-btn btn-add-star" title="Add Star" onclick="updateSticker(${student.id}, 'stars', 1)">⭐</button>
                            <button class="action-btn btn-rem-star" title="Remove Star" onclick="updateSticker(${student.id}, 'stars', -1)">-</button>
                        </div>
                        <button class="action-btn btn-add-heart" title="Add Heart" onclick="updateSticker(${student.id}, 'hearts', 1)">❤️</button>
                        <button class="action-btn btn-add-trophy" title="Add Trophy" onclick="updateSticker(${student.id}, 'trophies', 1)">🏆</button>
                    </div>
                `;
                board.appendChild(card);
            });
        }

        // Lightweight Custom Confetti System (No external libraries required)
        const canvas = document.getElementById('confetti-canvas');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        let particles = [];

        function fireConfetti() {
            const colors = ['#ff6b6b', '#4ecdc4', '#ffe66d', '#a55eea', '#2ecc71'];
            for (let i = 0; i < 150; i++) {
                particles.push({
                    x: canvas.width / 2,
                    y: canvas.height + 10,
                    r: Math.random() * 6 + 4,
                    dx: Math.random() * 20 - 10,
                    dy: Math.random() * -15 - 10,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    tilt: Math.floor(Math.random() * 10) - 10,
                    tiltAngleInc: (Math.random() * 0.07) + 0.05,
                    tiltAngle: 0
                });
            }
            animateConfetti();
        }

        function animateConfetti() {
            requestAnimationFrame(animateConfetti);
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            particles.forEach((p, index) => {
                p.tiltAngle += p.tiltAngleInc;
                p.y += (Math.cos(p.tiltAngle) + 1 + p.r / 2) / 2;
                p.x += Math.sin(p.tiltAngle) * 2;
                p.dy += 0.2; // gravity
                p.y += p.dy;

                ctx.beginPath();
                ctx.lineWidth = p.r;
                ctx.strokeStyle = p.color;
                ctx.moveTo(p.x + p.tilt + p.r, p.y);
                ctx.lineTo(p.x + p.tilt, p.y + p.tilt + p.r);
                ctx.stroke();

                if (p.y > canvas.height) {
                    particles.splice(index, 1);
                }
            });
        }

        // Resize canvas on window resize
        window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        });

        // Initial Render
        renderBoard();
    </script>
</body>
</html>
